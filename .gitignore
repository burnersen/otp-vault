# --- Secrets: never commit (dev-starterkit 08-security.md) ---
.env
.env.*
*.key
*.pem
*.pfx
*.p12
secrets/

# --- Build output: belongs to a release, not to the repository ---
build/bin/
# With a leading slash: a bare "dist/" would also hide frontend/dist, the page.
/dist/
*.exe
*.syso
*.test
# Generated by "wails build" without -skipbindings; this project calls
# window.go.main.App directly and needs none of it.
frontend/wailsjs/

# --- Files the program writes when started from here ---
*.log
*.log.[0-9]
portable.txt
logs/

# --- Private notes and safety copies: never public ---
_notes/
_backup*/

# --- Editors and operating systems ---
.vscode/
.idea/
node_modules/
Thumbs.db
desktop.ini
.DS_Store
